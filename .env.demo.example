# Exhibition PC local baseline configuration.
# Copy to `.env` on the exhibition PC only if the runbook asks for env wiring.
# No provider secrets are required for the local fallback route.

APP_ENV=exhibition-local
PUBLIC_API_BASE_URL=http://127.0.0.1:8010
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8010
PUBLIC_VIEWER_BASE_URL=http://127.0.0.1:8010
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://localhost:5173
LOG_LEVEL=info

DASHBOARD_PORT=8010
QUEST_VIEWER_PORT=5173
QUEST_API_TARGET=http://127.0.0.1:8010
QUEST_HOST=0.0.0.0
QUEST_PORT=5173

STORE_DRIVER=json
ARTIFACT_STORE_DRIVER=local
LIVE_STATE_DRIVER=memory
QUEUE_DRIVER=inline
REPLAY_ARTIFACT_ROOT=qa/replay

GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
SAKURA_AI_ENGINE_TOKEN=

VOICE_TRIGGER_PHRASE=seisei
