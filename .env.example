# Copy this file to `.env` and set the providers you want to use.
# Web Forge texture generation is fixed to `nano_banana` (Gemini-first).

# Public service wiring. Local defaults keep the current dashboard/static server
# as the API and asset origin; cloud deployment should override these per env.
APP_ENV=local
PUBLIC_API_BASE_URL=http://127.0.0.1:8010
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8010
PUBLIC_VIEWER_BASE_URL=http://127.0.0.1:8010
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://localhost:5173
LOG_LEVEL=info

# Future storage/DB split. Keep local drivers until artifact storage and DB
# repositories are implemented.
STORE_DRIVER=json
ARTIFACT_STORE_DRIVER=local
ARTIFACT_BUCKET=
ARTIFACT_PUBLIC_BASE_URL=
LIVE_STATE_DRIVER=memory
QUEUE_DRIVER=inline
JOB_TIMEOUT_SECONDS=240
JOB_MAX_RETRIES=1

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_ID=gemini-2.5-flash-image
GEMINI_FAST_MODEL=gemini-2.5-flash-image
GEMINI_REFINE_MODEL=gemini-2.5-flash-image
GEMINI_HERO_MODEL=gemini-3-pro-image-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-image-preview

# Optional legacy providers; Web Forge texture generation does not use these.
FAL_KEY=YOUR_FAL_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
FAL_FAST_DRAFT_MODEL=fal-ai/flux/schnell
FAL_QUALITY_REFINE_MODEL=fal-ai/flux/dev
OPENAI_HERO_MODEL=gpt-image-1

# Sakura AI Engine audio bridge.
SAKURA_AI_ENGINE_TOKEN=YOUR_SAKURA_AI_ENGINE_TOKEN_HERE
SAKURA_AI_ENGINE_BASE_URL=https://api.ai.sakura.ad.jp/v1
SAKURA_LLM_MODEL=gpt-oss-120b
SAKURA_WHISPER_MODEL=whisper-large-v3-turbo
SAKURA_TTS_MODEL=zundamon
SAKURA_TTS_VOICE=normal
SAKURA_TTS_FORMAT=wav
VOICE_TRIGGER_PHRASE=変身

# Quest 3 same-LAN HTTPS dev server.
# Required for Quest Browser microphone/WebXR when not using localhost.
QUEST_HOST=0.0.0.0
QUEST_PORT=5173
QUEST_API_TARGET=http://127.0.0.1:8010
QUEST_HTTPS_PFX=config/quest-lan.pfx
# Set your own passphrase; regenerate the cert with tools/new_quest_lan_cert.ps1
# if this file's previous default was ever used on an untrusted LAN.
QUEST_HTTPS_PFX_PASSWORD=CHOOSE_A_PASSPHRASE
QUEST_HTTPS_CERT=config/quest-lan.pem
QUEST_HTTPS_KEY=config/quest-lan-key.pem

# 蒸着執行録 Web動線(Supabase格納 + Cloud Run鍛造工場)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_OR_SB_SECRET_KEY
FORGE_TOKEN=LONG_RANDOM_STRING_SHARED_WITH_VERCEL
GEMINI_TEXT_MODEL=gemini-2.5-flash
