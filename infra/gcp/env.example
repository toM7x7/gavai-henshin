# Cloud Run environment for the henshin API/dashboard service.
# Naming is reconciled with the repo-root .env.example (the drivers the code
# validates via tools/validate_service_deployment_contract.py). The old
# NEW_ROUTE_* scheme is retired; see docs/cloud-architecture-2026-07.md.

# --- Service identity ---
APP_ENV=cloud
GCP_PROJECT_ID=gavai-henshin-dev
CLOUD_RUN_SERVICE_URL=https://henshin-api-ui-XXXXXXXX.a.run.app

# --- Public wiring (external mode forbids localhost / private LAN / http) ---
PUBLIC_API_BASE_URL=https://henshin-api-ui-XXXXXXXX.a.run.app
PUBLIC_ASSET_BASE_URL=https://henshin-api-ui-XXXXXXXX.a.run.app
PUBLIC_VIEWER_BASE_URL=https://henshin-api-ui-XXXXXXXX.a.run.app
CORS_ALLOWED_ORIGINS=https://henshin-api-ui-XXXXXXXX.a.run.app

# --- Storage drivers (phase 0: lift-and-shift keeps local JSON, 1 instance) ---
STORE_DRIVER=json                 # json -> cloudsql (phase 1)
ARTIFACT_STORE_DRIVER=local       # local -> gcs (phase 1)
ARTIFACT_BUCKET=gavai-henshin-artifacts-dev
ARTIFACT_PUBLIC_BASE_URL=https://storage.googleapis.com/gavai-henshin-artifacts-dev
LIVE_STATE_DRIVER=memory          # memory -> firestore (phase 2)
QUEUE_DRIVER=inline               # inline -> cloud-tasks (phase 2)

# --- Cloud SQL (phase 1) ---
CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:gavai-henshin-sql
DATABASE_URL=postgresql://gavai_api:CHANGE_ME@localhost:5432/gavai_henshin

# --- Firestore live state (phase 2) ---
FIREBASE_PROJECT_ID=gavai-henshin-dev
FIRESTORE_LIVE_STATE_PREFIX=dev

# --- Async jobs (phase 2) ---
TASKS_QUEUE_NAME=henshin-generation-jobs
JOB_TIMEOUT_SECONDS=240
JOB_MAX_RETRIES=1

# --- Secrets: never set values here; bind via Secret Manager ---
# GEMINI_API_KEY          -> secret: henshin-gemini-api-key
# SAKURA_AI_ENGINE_TOKEN  -> secret: henshin-sakura-token
SECRET_MANAGER_PREFIX=henshin-

# --- Auth boundary (phase 3) ---
FIREBASE_AUTH_AUDIENCE=gavai-henshin
SERVICE_ACCOUNT_EMAIL=gavai-api@gavai-henshin-dev.iam.gserviceaccount.com
